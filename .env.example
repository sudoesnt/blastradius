# Optional LLM API keys.
# If none are set, BlastRadius automatically uses your local `claude` CLI (Claude Code),
# or falls back to the built-in deterministic practitioner analyzer.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Optional X / Twitter API v2 Bearer Token for live infosec X stream
# X_BEARER_TOKEN=

# Optional GitHub token for higher GitHub Advisory API rate limits
# GITHUB_TOKEN=

# Dashboard server port (default 3377)
# PORT=3377
