# Optional model API keys. If none are set, BlastRadius uses your local `claude` CLI.
# With no engine available, incidents are listed with sources only (no analysis is invented).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Optional: model for the local claude CLI (defaults to the CLI's own default)
# BLASTRADIUS_CLAUDE_MODEL=

# Optional X / Twitter API v2 bearer token
# X_BEARER_TOKEN=

# Optional GitHub token for higher GitHub Advisory API rate limits (no scopes needed)
# GITHUB_TOKEN=

# Dashboard port (default 3377)
# PORT=3377
