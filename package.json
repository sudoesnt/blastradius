{
  "name": "blastradius",
  "version": "0.1.0",
  "description": "Role-tailored threat and breach digest: clusters coverage from curated security sources, states what is disclosed versus inferred about each root cause, and checks relevance against your own inventory.",
  "type": "module",
  "bin": {
    "blastradius": "./src/cli.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "digest": "node src/cli.mjs run --hours 168",
    "digest:48h": "node src/cli.mjs run --hours 48",
    "digest:24h": "node src/cli.mjs run --hours 24",
    "collect": "node src/cli.mjs collect",
    "sources": "node src/cli.mjs sources",
    "inventory": "node src/cli.mjs inventory",
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "eval": "node src/cli.mjs eval"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
